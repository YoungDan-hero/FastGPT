# 客户端能访问的站点和 MCP SSE 地址。部署到正式环境时填各自的 HTTPS origin。
MAIYA_PUBLIC_URL=http://127.0.0.1:13100
MCP_SSE_PUBLIC_URL=http://127.0.0.1:13103
MAIYA_COOKIE_SECURE=false
MAIYA_APP_PORT=13100
MAIYA_MCP_PORT=13103
MAIYA_APP_IMAGE=maiya-studio:4.18.0.2-20261124
MAIYA_PDF_IMAGE=maiya-pdf-parser:4.2.3
PDF_MODEL_SOURCE=auto
PDF_MODEL_HTTPS_PROXY=

# 飞书回调 URL 由 MAIYA_PUBLIC_URL + /api/support/user/account/login/feishu/callback 生成。
FEISHU_ORG_ENABLED=false
FEISHU_ORG_APP_ID=
FEISHU_ORG_APP_SECRET=
FEISHU_ORG_PROTECTED_ADMIN_OPEN_ID=
FEISHU_BOT_APP_ID=
FEISHU_BOT_APP_SECRET=

# 上游模型渠道
DASHSCOPE_API_KEY=
ARK_API_KEY=

# 每项独立生成。数据库密码请用纯字母数字，例如 openssl rand -hex 24。
MONGO_PASSWORD=
PG_PASSWORD=
REDIS_PASSWORD=
STORAGE_ACCESS_KEY_ID=maiya-storage
STORAGE_SECRET_ACCESS_KEY=
ROOT_KEY=
FILE_TOKEN_KEY=
AES256_SECRET_KEY=
INVOKE_TOKEN_SECRET=
AIPROXY_API_TOKEN=
PLUGIN_TOKEN=
CODE_SANDBOX_TOKEN=
PDF_PARSE_KEY=
